# Example environment variables — copy to .env.local for local dev

# Public URL of the deployed app (no trailing slash).
# Used by build-spa.js to generate the SPA shell with the correct base URL.
# REQUIRED during build — set this in your Vercel / hosting environment variables.
VITE_PUBLIC_URL=

# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
